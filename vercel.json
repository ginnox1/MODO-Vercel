{
  "buildCommand": "pnpm build:client",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "regions": ["fra1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
